{
  "name": "capygen-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "corepack pnpm --filter @capygen/renderer build && corepack pnpm --filter @capygen/desktop build",
    "start": "corepack pnpm --dir apps/desktop exec electron .",
    "test": "vitest run",
    "typecheck": "corepack pnpm -r --if-present typecheck && tsc -p tests/tsconfig.json",
    "e2e": "corepack pnpm build && playwright test",
    "e2e:only": "playwright test",
    "spike": "corepack pnpm --filter @capygen/engine spike"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
